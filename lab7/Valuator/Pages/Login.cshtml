@page
@model Valuator.Pages.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<h1>Вход</h1>
<form method="post">
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Login">Логин</label>
        <input asp-for="Input.Login" class="form-control" autocomplete="username" required />
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password">Пароль</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" required />
    </div>
    <button type="submit" class="btn btn-primary">Войти</button>
</form>
<a asp-page="/Register">Зарегистрироваться</a>
